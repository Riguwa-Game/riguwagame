# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Local-chain and dry-run broadcast logs. The real-network ones are kept: they carry the
# deployment transaction hashes that DEPLOYMENT.md points at.
broadcast/**/31337/
broadcast/**/dry-run/
